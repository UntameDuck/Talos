# BoundAuth 환경 변수 예시. 실제 값은 `.env` 에 두고 저장소에 커밋하지 않는다.
# 모든 변수는 BOUNDAUTH_ 접두사를 쓴다.

# dev | test | prod
BOUNDAUTH_ENV=dev

# 오류 응답에 내부 error code 포함 여부. dev/test=true, prod=false 권장.
BOUNDAUTH_DETAILED_ERRORS=true

# 비우면 server/.data/ 아래 SQLite 를 자동 사용한다. PostgreSQL 예:
# BOUNDAUTH_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/boundauth
BOUNDAUTH_DATABASE_URL=

# 서버 토큰 서명용 P-256 개인키(PEM) 경로.
# 파일이 없고 ENV!=prod 이면 자동 생성한다. prod 에서는 반드시 사전 프로비저닝.
# 이 파일은 절대 커밋하지 않는다 (.gitignore 에 server/.keys/ 포함).
BOUNDAUTH_SIGNING_KEY_PATH=server/.keys/server_es256.pem

# 토큰 issuer 및 외부 공개 base URL(htu 정규화 기준). 리버스 프록시 뒤에서 필수.
BOUNDAUTH_ISSUER=https://boundauth.local
BOUNDAUTH_PUBLIC_BASE_URL=https://boundauth.local

# 토큰 수명(초)
BOUNDAUTH_ACCESS_TOKEN_TTL_SECONDS=900
BOUNDAUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# DPoP
BOUNDAUTH_DPOP_IAT_SKEW_SECONDS=60
BOUNDAUTH_DPOP_REPLAY_TTL_SECONDS=300
BOUNDAUTH_DPOP_REQUIRE_NONCE=false
BOUNDAUTH_NONCE_TTL_SECONDS=300
BOUNDAUTH_DPOP_MAX_PROOF_BYTES=4096

# 데모 계정 시드. 비밀번호가 비어 있으면 계정을 만들지 않는다(기본 비밀번호 금지).
BOUNDAUTH_SEED_USERNAME=demo
BOUNDAUTH_SEED_PASSWORD=

# 로그 레벨
BOUNDAUTH_LOG_LEVEL=INFO
